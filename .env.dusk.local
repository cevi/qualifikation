# Umgebung für Laravel Dusk (php artisan dusk): Dusk ersetzt während des Laufs die .env durch diese Datei.
# Keine Geheimnisse, keine echten Dienste. Der Browser (Selenium-Container) ruft die App unter laravel.test auf.
# Env-Namen wie in config/*.php (z. B. MAIL_DRIVER, CACHE_DRIVER), Schalter wie in phpunit.xml.
APP_NAME=Qualitool
APP_ENV=local
APP_KEY=base64:d4X3bIyAyX4rZM3oV9MYZB1zTK18SAskUobPgcSE2UI=
APP_DEBUG=true
APP_URL=http://laravel.test
LOG_CHANNEL=single

# SQLite als Datei: Testprozess und Webserver müssen dieselbe Datenbank sehen (in-memory geht nicht)
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/dusk.sqlite

# array: Zähler der Anfrage-Begrenzung (throttle) nicht über Tests hinweg behalten
CACHE_DRIVER=array
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=test@example.com
MAIL_FROM_NAME=Qualitool
MAIL_CAMP_NAME=Kursteam
MAIL_CAMP_ADDRESS=kursteam@example.com
BCRYPT_ROUNDS=4
ADMIN_PASSWORD=password

# Spam-Schutz würde schnelle Formulareingaben des Browsers abweisen
HONEYPOT_ENABLED=false

# Import-Knöpfe anzeigen, damit sie mitgeprüft werden (angeklickt wird nichts, siehe Cevi-DB unten)
IMPORT_DB=true

# Externe Dienste: keine echten Endpunkte
HITOBITO_BASE_URL=http://127.0.0.1:9
HITOBITO_CLIENT_UID=dusk
HITOBITO_CLIENT_SECRET=dusk
HITOBITO_CALLBACK_URI=http://laravel.test/login/hitobito/callback
JEMK_BASE_URL=http://127.0.0.1:9
JEMK_CLIENT_UID=dusk
JEMK_CLIENT_SECRET=dusk
JEMK_CALLBACK_URI=http://laravel.test/login/jemk/callback
GITHUB_TOKEN=
GITHUB_API_URL=http://127.0.0.1:9
GITHUB_USER=
SENTRY_LARAVEL_DSN=
SENTRY_DSN=

# Sail: Selenium statt lokalem ChromeDriver
DUSK_DRIVER_URL=http://selenium:4444/wd/hub
